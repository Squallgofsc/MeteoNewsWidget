<Window x:Class="MeteoNewsWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height"
        Background="#FF1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF64B4FF"/>
                    <Setter Property="Foreground" Value="#FF14141E"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A5E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" x:Name="TxtTitle"
                   Text="Paramètres" FontSize="16"
                   Foreground="#FF64B4FF" Margin="0,0,0,16"/>

        <!-- Langue -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="LblLanguage"
               Text="Langue" Foreground="#FFAAAAAA"
               FontSize="11" Margin="0,0,0,4"/>
            <ListBox x:Name="CmbLanguage"
             Background="#FF2A2A3E"
             BorderBrush="#FF64B4FF"
             BorderThickness="1"
             MaxHeight="120"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#FF2A2A3E"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF64B4FF"/>
                                <Setter Property="Foreground" Value="#FF14141E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A3A5E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>

        <!-- Ville -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="LblCity"
                       Text="Ville" Foreground="#FFAAAAAA"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtCity"
                     Background="#FF2A2A3E" Foreground="White"
                     BorderBrush="#FF64B4FF" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Clé API -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock x:Name="LblApiKey"
                       Text="Clé API OpenWeatherMap" Foreground="#FFAAAAAA"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtApiKey"
                     Background="#FF2A2A3E" Foreground="White"
                     BorderBrush="#FF64B4FF" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Mot-clé Thème -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock x:Name="LblTheme"
                       Text="Mot-clé filtre Thème" Foreground="#FFAAAAAA"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtTheme"
                     Background="#FF2A2A3E" Foreground="White"
                     BorderBrush="#FF64B4FF" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Username Wikipedia -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock x:Name="LblWikiUser"
                       Text="Nom d'utilisateur Wikipedia" Foreground="#FFAAAAAA"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtWikiUser"
                     Background="#FF2A2A3E" Foreground="White"
                     BorderBrush="#FF64B4FF" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Token Wikipedia -->
        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock x:Name="LblWikiToken"
                       Text="Token Wikipedia (liste de suivi)" Foreground="#FFAAAAAA"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtWikiToken"
                     Background="#FF2A2A3E" Foreground="White"
                     BorderBrush="#FF64B4FF" BorderThickness="1"
                     Padding="6,4"/>
        </StackPanel>

        <!-- Toujours au premier plan -->
        <StackPanel Grid.Row="7" Margin="0,0,0,10">
            <CheckBox x:Name="ChkAlwaysOnTop"
              Foreground="White"
              Content="Toujours au premier plan"
              IsChecked="True"/>
        </StackPanel>
        
        <!-- Boutons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnCancel"
                    Width="80" Height="30"
                    Background="#FF2A2A3E" Foreground="White"
                    BorderBrush="#FF64B4FF" BorderThickness="1"
                    Cursor="Hand" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave"
                    Width="100" Height="30"
                    Background="#FF64B4FF" Foreground="#FF14141E"
                    BorderBrush="Transparent" FontWeight="Bold"
                    Cursor="Hand" Margin="10,0,0,0"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>